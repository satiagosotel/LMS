							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"nuevo_usuario\",\n    \"password\": \"password123\",\n    \"email\": \"usuario@email.com\",\n    \"roles\": []\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/admin/users/create",
							"host": ["{{baseUrl}}"],
							"path": ["api", "admin", "users", "create"]
						}
					}
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
