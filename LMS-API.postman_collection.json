{
	"info": {
		"name": "LMS API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"santi\",\n    \"password\": \"123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Courses",
			"item": [
				{
					"name": "Get All Courses",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/courses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses"]
						}
					}
				},
				{
					"name": "Get Course By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/courses/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses", "1"]
						}
					}
				},
				{
					"name": "Create Course (ADMIN)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Curso de Spring Boot\",\n    \"description\": \"Aprende Spring Boot desde cero\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/courses/create",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses", "create"]
						}
					}
				},
				{
					"name": "Update Course (ADMIN)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Curso de Spring Boot Actualizado\",\n    \"description\": \"Descripcion actualizada\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/courses/update/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses", "update", "1"]
						}
					}
				},
				{
					"name": "Delete Course (ADMIN)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/courses/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses", "1"]
						}
					}
				}
			]
		},
		{
